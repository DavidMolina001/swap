{
  "meta": {
    "product": "Swap",
    "version": "0.8.0",
    "note": "Single source of truth for the switcher's look. `python3 design/gen-tokens.py` writes src/Tokens.swift and windows/Tokens.cs from this file; never edit those by hand. Colours are rgba(r,g,b,a) or `accent@alpha` (the system accent colour at that alpha). Sizes are points on the Mac and device independent pixels at 96 dpi on Windows. Every colour has a dark and a light value: the panel follows the system appearance (or the user's choice in Settings). Optional on a colour: contrastDark and contrastLight replace it when Increase Contrast is on (Mac), and onAccent marks text drawn on the selected row, which Theme turns black on a light accent colour."
  },
  "color": {
    "panelTint": {
      "dark": "rgba(0,0,0,0.60)",
      "light": "rgba(255,255,255,0.55)",
      "note": "Over the blur. Keeps the backdrop dark enough / light enough for the text, also over bright windows."
    },
    "panelSolid": {
      "dark": "rgba(30,30,32,1)",
      "light": "rgba(242,242,244,1)",
      "note": "Reduce Transparency, offscreen snapshots, Windows surface."
    },
    "rimInner": {
      "dark": "rgba(255,255,255,0.14)",
      "light": "rgba(255,255,255,0.60)",
      "note": "1 pt inner stroke."
    },
    "rimOuter": {
      "dark": "rgba(0,0,0,0.20)",
      "light": "rgba(0,0,0,0.12)",
      "note": "0.5 pt outer hairline."
    },
    "rimContrast": {
      "dark": "rgba(255,255,255,0.30)",
      "light": "rgba(0,0,0,0.30)",
      "note": "Rim when Increase Contrast is on."
    },
    "label": {
      "dark": "rgba(255,255,255,1)",
      "light": "rgba(0,0,0,0.85)"
    },
    "secondary": {
      "dark": "rgba(255,255,255,0.55)",
      "light": "rgba(0,0,0,0.58)",
      "contrastDark": "rgba(255,255,255,1)",
      "contrastLight": "rgba(0,0,0,0.85)",
      "note": "4.5:1 on the solid panel in both modes."
    },
    "tertiary": {
      "dark": "rgba(255,255,255,0.35)",
      "light": "rgba(0,0,0,0.30)",
      "contrastDark": "rgba(255,255,255,0.70)",
      "contrastLight": "rgba(0,0,0,0.60)",
      "note": "Decorative, except with Increase Contrast, where it reaches 4.5:1."
    },
    "separator": {
      "dark": "rgba(255,255,255,0.10)",
      "light": "rgba(0,0,0,0.10)"
    },
    "selection": {
      "dark": "accent@0.90",
      "light": "accent@0.90",
      "note": "Solid fill, no stroke. 1.0 when Increase Contrast is on."
    },
    "selectionText": {
      "dark": "rgba(255,255,255,1)",
      "light": "rgba(255,255,255,1)",
      "onAccent": true,
      "note": "White, or black when the accent colour is too light for white."
    },
    "selectionSub": {
      "dark": "rgba(255,255,255,0.80)",
      "light": "rgba(255,255,255,0.80)",
      "onAccent": true,
      "note": "App name on the selected row."
    },
    "hover": {
      "dark": "rgba(255,255,255,0.08)",
      "light": "rgba(0,0,0,0.05)"
    },
    "capsuleFill": {
      "dark": "rgba(255,255,255,0.12)",
      "light": "rgba(0,0,0,0.08)",
      "note": "The 'Minimised' capsule."
    },
    "dotActive": {
      "dark": "rgba(255,255,255,1)",
      "light": "rgba(0,0,0,0.85)"
    },
    "dotInactive": {
      "dark": "rgba(255,255,255,0.30)",
      "light": "rgba(0,0,0,0.30)",
      "contrastDark": "rgba(255,255,255,0.50)",
      "contrastLight": "rgba(0,0,0,0.50)",
      "note": "With Increase Contrast it reaches 3:1."
    },
    "chevron": {
      "dark": "rgba(255,255,255,0.40)",
      "light": "rgba(0,0,0,0.40)",
      "contrastDark": "rgba(255,255,255,0.70)",
      "contrastLight": "rgba(0,0,0,0.60)"
    },
    "chevronEnd": {
      "dark": "rgba(255,255,255,0.15)",
      "light": "rgba(0,0,0,0.15)",
      "note": "Chevron on a side with no more desktops."
    },
    "glanceWarning": {
      "dark": "rgba(255,159,10,1)",
      "light": "rgba(255,149,0,1)",
      "note": "Glance bar: tile and value on a warning (systemOrange)."
    },
    "glanceLimit": {
      "dark": "rgba(255,69,58,1)",
      "light": "rgba(255,59,48,1)",
      "note": "Glance bar: at the limit (systemRed)."
    },
    "glanceTrack": {
      "dark": "rgba(255,255,255,0.12)",
      "light": "rgba(0,0,0,0.08)",
      "note": "Level bar track at Detailed density."
    },
    "tileCPU": {
      "dark": "rgba(10,132,255,1)",
      "light": "rgba(0,122,255,1)"
    },
    "tileMemory": {
      "dark": "rgba(94,92,230,1)",
      "light": "rgba(88,86,214,1)"
    },
    "tileGPU": {
      "dark": "rgba(191,90,242,1)",
      "light": "rgba(175,82,222,1)"
    },
    "tileQuota": {
      "dark": "rgba(255,55,95,1)",
      "light": "rgba(255,45,85,1)",
      "note": "Placeholder until Quota's brand colour is confirmed."
    },
    "tileNetwork": {
      "dark": "rgba(48,209,88,1)",
      "light": "rgba(52,199,89,1)"
    },
    "tileDownloads": {
      "dark": "rgba(152,152,157,1)",
      "light": "rgba(142,142,147,1)"
    },
    "tileTimer": {
      "dark": "rgba(0,199,190,1)",
      "light": "rgba(0,167,157,1)"
    },
    "tileCalendar": {
      "dark": "rgba(172,142,104,1)",
      "light": "rgba(162,132,94,1)"
    },
    "tileGlyph": {
      "dark": "rgba(255,255,255,1)",
      "light": "rgba(255,255,255,1)"
    },
    "tileHairline": {
      "dark": "rgba(0,0,0,0.10)",
      "light": "rgba(0,0,0,0.10)",
      "note": "0.5 pt inset stroke so light tiles hold their edge."
    }
  },
